              )}
            </View>

            <ButtonCompo
              title={buttonLabel}
              onPress={async () => {
                const now = new Date().toISOString();
                await AsyncStorage.removeItem('punch_time');
                setCheckInTime(now);
                setPunchType(buttonLabel === 'Check In' ? 'IN' : 'OUT');

                setButtonLabel(prev =>
                  prev === 'Check In' ? 'Check Out' : 'Check In',
